abi <abi/4.0>,
include <tunables/global>

profile "${executable}" "/opt/${sanitizedProductName}/${executable}" flags=(attach_disconnected,mediate_deleted) {
  # Distribution-maintained rule sets, used in preference to hand-listing
  # paths: they track where the system actually keeps fonts, DRI nodes and
  # theme data across releases, which a hardcoded list here would not.
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/fonts>
  #include <abstractions/freedesktop.org>
  #include <abstractions/gnome>
  #include <abstractions/X>
  #include <abstractions/wayland>
  #include <abstractions/dri-common>
  #include <abstractions/dri-enumerate>
  #include <abstractions/mesa>
  #include <abstractions/audio>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/user-tmp>

  # Allow unprivileged user namespace creation for Chromium/Electron sandbox
  userns,

  # Executable & library permissions
  #
  # `ix` (inherit) on the binary itself is load-bearing: Chromium starts its
  # zygote, GPU and renderer processes by re-executing this same binary, so
  # without an exec permission the app dies at startup with "failed to execvp"
  # and a zygote_host check failure — an error that never names AppArmor.
  /opt/${sanitizedProductName}/${executable} mrix,
  /opt/${sanitizedProductName}/chrome-sandbox rix,
  /opt/${sanitizedProductName}/chrome_crashpad_handler rix,
  /opt/${sanitizedProductName}/** r,
  # `**/*.so*` requires at least one directory level, so it silently missed the
  # shared objects Electron ships directly in the install root — libffmpeg.so
  # among them, which killed the app at launch. `**.so*` matches any depth
  # including zero.
  /opt/${sanitizedProductName}/**.so* mr,
  # Native Node addons are shared objects with a different extension, and this
  # app has two that are not optional: argon2 hashes every password and
  # better-sqlite3 opens the encrypted database. Missing this means the app
  # starts and then dies on its first real action.
  /opt/${sanitizedProductName}/**.node mr,

  # User data directories
  owner @{HOME}/.config/${executable}/** rwkl,
  owner @{HOME}/.config/${sanitizedProductName}/** rwkl,

  # Temporary and shared memory files
  /tmp/** rwkl,
  /dev/shm/** rwkl,
  /run/user/*/** rwkl,

  # System status and devices
  # `/ r` is the root directory listing glycin (GTK's image loader) asks for
  # when it sets up its own sandbox; without it every launch logs an alarming
  # ERROR about being unable to read /, which is neither fatal nor a real
  # permission problem worth teaching support staff to ignore.
  / r,
  /sys/bus/pci/devices/ r,
  /sys/devices/** r,
  /proc/** r,
  /etc/** r,
  /usr/share/** r,
  /usr/lib/** r,
  # Chromium reads the user's GTK theme and icon set to match the desktop.
  owner @{HOME}/.themes/** r,
  owner @{HOME}/.icons/** r,
  owner @{HOME}/.local/share/** r,
  owner @{HOME}/.fonts/** r,
  owner @{HOME}/.cache/fontconfig/** rwkl,

  # Network and desktop communication
  network,
  dbus,

  # Chromium's multi-process model: the browser process supervises and traces
  # its own children, and they signal each other on shutdown.
  ptrace peer=@{profile_name},
  signal peer=@{profile_name},
  # Without this the app can only be signalled by itself: a plain `kill`, a
  # terminal Ctrl-C, or the session manager shutting the desktop down are all
  # refused, so the process survives everything short of SIGKILL from root.
  #
  # Deliberately unqualified rather than `peer=unconfined`: the sender is very
  # often confined itself — a terminal, an IDE, the session manager — and
  # naming only unconfined leaves those still refused. Receiving a signal is
  # not a privilege this app holds over anything; whoever can signal it already
  # has that right from the kernel by uid.
  signal (receive),

  # Chromium's own sandbox builds a locked-down PID/network namespace with an
  # empty root for each renderer. That is the layer that actually contains a
  # compromised renderer, so it has to be permitted for the app to start at
  # all — denying it does not harden anything, it just stops Chromium before
  # it can sandbox itself.
  capability sys_admin,
  capability sys_chroot,
  capability sys_ptrace,
  capability setuid,
  capability setgid,
  capability dac_override,
  capability dac_read_search,
  mount,
  umount,
  pivot_root,

  # The trailing-slash forms are directory reads; `@{PROC}/**` alone does not
  # grant them, and the sandbox enumerates its own thread list at startup.
  @{PROC}/ r,
  @{PROC}/** r,
  @{PROC}/*/ r,
  @{PROC}/*/task/ r,
  # Chromium lowers the OOM score of its renderers so the kernel kills a tab
  # rather than the browser when memory runs out, and writes setgroups while
  # building the sandbox user namespace. Read access is not enough for either.
  owner @{PROC}/*/oom_score_adj w,
  owner @{PROC}/*/oom_adj w,
  owner @{PROC}/*/setgroups w,
  @{PROC}/*/oom_score_adj w,
  @{PROC}/*/oom_adj w,

  # Opening a file, folder or link in the user's own applications goes through
  # xdg-open, which is a shell script. Without this, "open containing folder"
  # and every external link in the app silently do nothing.
  /usr/bin/dash rix,
  /bin/dash rix,
  /usr/bin/xdg-open rix,
  /usr/bin/** rix,
  /bin/** rix,
  # The app reads the machine id by shelling out to `head`, and that value is
  # what its database encryption key is derived from. On a distribution that
  # ships uutils, `head` lives under /usr/lib rather than /usr/bin, so a rule
  # covering only /usr/bin let the exec fail — node-machine-id then fell back
  # to a hostname-derived id, the app computed a *different* key, and the
  # database it had written the day before came back as "file is not a
  # database". Nothing announced a permission problem; it looked exactly like
  # total data loss. Read access alone is not enough here: it has to execute.
  /usr/lib/** rix,
  /usr/libexec/** rix,

  # GTK reads the desktop's settings (theme, fonts, scaling) from dconf.
  owner @{HOME}/.config/dconf/user rw,
  owner /run/user/*/dconf/user rw,

  # Site-specific additions and overrides
  include if exists <local/${executable}>
}
